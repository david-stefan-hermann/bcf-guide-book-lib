{
  "schemaVersion": 1,
  "id": "bcfguidebooklib",
  "version": "${version}",
  "name": "BCF Guide Book Lib",
  "description": "The guide book of BaconCakeFactory's mods: one screen, one layout and one way to turn the pages. Bundled inside the mods that use it.",
  "authors": [
    "BaconCakeFactory"
  ],
  "contact": {
    "sources": "https://github.com/david-stefan-hermann/bcf-guide-book-lib"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "client": [
      "bcf.guidebook.client.GuideBookClient"
    ]
  },
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ]
    }
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21"
  }
}
